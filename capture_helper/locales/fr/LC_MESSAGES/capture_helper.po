msgstr "Retirer"

msgid "Save failed: {error}"
msgstr "Échec de l'enregistrement : {error}"

msgid "Save scene (JSON)"
msgstr "Enregistrer la scène (JSON)"

msgid "Saved & downloaded."
msgstr "Enregistré et téléchargé."

msgid "Saving…"
msgstr "Enregistrement…"

